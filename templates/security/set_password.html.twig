{% extends 'base.html.twig' %}

{% block pageTitle %}{% trans %}security.set_password{% endtrans %}{% endblock %}

{% block body %}
    <form method="post" class="space-y-4">
        <div>
            <label class="sr-only" for="inputPassword">{% trans %}security.password{% endtrans %}</label>
            <input type="password" name="password" id="inputPassword" class="w-full p-2 border border-gray-300 rounded-sm" placeholder="{% trans %}security.password{% endtrans %}" required>
        </div>
        <div>
            <label class="sr-only" for="inputPasswordAgain">{% trans %}security.password_again{% endtrans %}</label>
            <input type="password" name="password_again" id="inputPasswordAgain" class="w-full p-2 border border-gray-300 rounded-sm" placeholder="{% trans %}security.password_again{% endtrans %}" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('new-password') }}">
        <div>
            <button class="w-full p-2 bg-blue-500 text-white rounded-sm hover:bg-blue-600" type="submit">
                {% trans %}security.confirm_set_password{% endtrans %}
            </button>
        </div>
    </form>
{% endblock %}