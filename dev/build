#!/usr/bin/env sh
pwd

docker compose run --rm php-cli composer install --no-ansi --no-dev --no-interaction --no-progress --optimize-autoloader --no-scripts

rm -rf ./artifact

mkdir ./artifact
mkdir ./artifact/bin

cp -R ./{app,config,lib,public,src,symfony,var,vendor,web} ./artifact/
cp bin/{.bin/console,./bin/console.php,./bin/symfony-console,./bin/symfony-console.php} ./artifact/bin
cp ./migrations.yml ./artifact/
